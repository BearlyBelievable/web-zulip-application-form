{% for field in application_fields %}
<div class="form-field">
  {% if field.type == 'boolean' %}
  <fieldset>
    <legend>{{ field.label }}</legend>
    <label><input type="radio" name="{{ field.name }}" value="true" {% if field.required %}required{% endif %}> Yes</label>
    <label><input type="radio" name="{{ field.name }}" value="false" {% if field.required %}required{% endif %}> No</label>
  </fieldset>
  {% elif field.type == 'select' %}
  <label for="field-{{ field.name }}">{{ field.label }}</label>
  <select id="field-{{ field.name }}" name="{{ field.name }}" {% if field.required %}required{% endif %}>
    {% for option in field.options %}
    <option value="{{ option }}">{{ option }}</option>
    {% endfor %}
  </select>
  {% elif field.type == 'multiselect' %}
  <fieldset>
    <legend>{{ field.label }}</legend>
    {% for option in field.options %}
    <label><input type="checkbox" name="{{ field.name }}" value="{{ option }}"> {{ option }}</label>
    {% endfor %}
  </fieldset>
  {% elif field.type == 'textarea' %}
  <label for="field-{{ field.name }}">{{ field.label }}</label>
  <textarea id="field-{{ field.name }}" name="{{ field.name }}"
      maxlength="{{ field.maxlength | default(1000) }}"
      {% if field.minlength is defined %}minlength="{{ field.minlength }}"{% endif %}
      {% if field.required %}required{% endif %}></textarea>
  {% elif field.type == 'number' %}
  <label for="field-{{ field.name }}">{{ field.label }}</label>
  <input id="field-{{ field.name }}" type="number" name="{{ field.name }}"
      {% if field.min is defined %}min="{{ field.min }}"{% endif %}
      {% if field.max is defined %}max="{{ field.max }}"{% endif %}
      {% if field.required %}required{% endif %}>
  {% else %}
  <label for="field-{{ field.name }}">{{ field.label }}</label>
  <input id="field-{{ field.name }}" type="{{ field.type }}" name="{{ field.name }}"
      maxlength="{{ field.maxlength | default(250) }}"
      {% if field.minlength is defined %}minlength="{{ field.minlength }}"{% endif %}
      {% if field.required %}required{% endif %}>
  {% endif %}
</div>
{% endfor %}
