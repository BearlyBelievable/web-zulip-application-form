# Python
__pycache__/
*.pyc
.venv/

# Real secrets, generated by install.sh
secrets.conf

# Host-specific config, not secret but generated per install
config.conf

# Generated by install.sh under the site root. Only lands here, inside
# this app's own checkout, when no site root is configured.
/data/

# Backups of reverse-proxy site configs, made by install.sh before it
# edits one.
/reverse-proxy-backups/

# Local record of pending applications, used to detect a resubmission
# while the first one is still awaiting manual review.
applications.db
